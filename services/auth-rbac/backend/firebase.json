{
  "functions": [
    {
      "source":   "functions",
      "codebase": "default",
      "runtime":  "python311",
      "invoker":  "public",
      "ignore":   ["venv", ".venv", "**/__pycache__", "**/*.pyc", "tests/**"]
    }
  ],


"firestore": {
  "database": "simpletort-dev",
  "rules":    "firestore/firestore.rules",
  "indexes":  "firestore/firestore_indexes.json"
},

  "emulators": {
    "auth":      { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "ui":        { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
