{
  "functions": [
    {
      "source":   "functions",
      "codebase": "default",
      "runtime":  "python312",
      "ignore":   ["venv", ".venv", "**/__pycache__", "**/*.pyc", "tests/**"]
    }
  ],

  "hosting": {
    "site":   "simple-tort-zadroga-prod",
    "public": "frontend/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ]
  },

  "firestore": {
    "database": "simpletort-dev",
    "rules":    "firestore/firestore.rules",
    "indexes":  "firestore/firestore_indexes.json"
  }
}
