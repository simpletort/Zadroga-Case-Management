# Copy to .env for local development. Never commit .env.

# GCP
GCP_PROJECT_ID=your-project-id
APP_ENV=development

# JWT (Firebase)
JWT_AUDIENCE=your-firebase-project-id
JWT_ISSUER=https://securetoken.google.com/your-firebase-project-id

# Cloud Tasks
CLOUD_TASKS_HANDLER_URL=http://localhost:8080
CLOUD_TASKS_SA_EMAIL=lead-intake-sa@your-project-id.iam.gserviceaccount.com

# Notifications — leave blank in dev to use direct SendGrid/Twilio fallback
NOTIFICATION_SERVICE_URL=

# SendGrid (dev fallback)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@zadlegal.com

# Twilio (dev fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
